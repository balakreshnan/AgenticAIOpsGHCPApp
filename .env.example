# ---------------------------------------------------------------------------
# Microsoft Foundry project (Azure AI Projects SDK + Agent Framework)
# ---------------------------------------------------------------------------
# The Foundry project endpoint, e.g.
#   https://<your-resource>.services.ai.azure.com/api/projects/<project-name>
AZURE_AI_PROJECT_ENDPOINT=

# Default model deployment used by Agent Framework when an agent does not
# specify one (e.g. gpt-5.4-mini, gpt-4o).
AZURE_AI_MODEL_DEPLOYMENT=gpt-5.4-mini

# ---------------------------------------------------------------------------
# Evaluations (Azure AI Evaluation SDK)
# ---------------------------------------------------------------------------
# Deployment name of the judge LLM used by AI-assisted evaluators (relevance,
# coherence, fluency, groundedness, similarity, retrieval, completeness).
# Must be a real chat-model deployment in your Foundry resource. Defaults to
# AZURE_AI_MODEL_DEPLOYMENT when unset.
AZURE_EVAL_JUDGE_MODEL=gpt-5.4-mini

# Azure OpenAI base endpoint for the judge model. Defaults to the account
# endpoint derived from AZURE_AI_PROJECT_ENDPOINT, e.g.
#   https://<your-resource>.services.ai.azure.com
AZURE_OPENAI_ENDPOINT=

# Azure OpenAI API version used by the judge model.
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional: override the evaluation dataset paths (JSONL). Default to the files
# shipped in ./evaldata.
# AZURE_EVAL_DATASET=evaldata/datarfp.jsonl
# AZURE_EVAL_AGENT_DATASET=evaldata/datarfpagent.jsonl

# ---------------------------------------------------------------------------
# Assert (ASSERT / assert_ai spec-driven testing)
# ---------------------------------------------------------------------------
# Name of the hosted Foundry agent the Assert tab tests. Defaults to rfpagent.
# ASSERT_TARGET_AGENT=rfpagent

# ---------------------------------------------------------------------------
# Governance (Agent Governance Toolkit)
# ---------------------------------------------------------------------------
# Human sponsor email used when minting the agent's zero-trust identity in the
# Governance tab. Defaults to agent-owner@contoso.com.
# GOVERNANCE_SPONSOR_EMAIL=agent-owner@contoso.com

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# This app authenticates with Azure using DefaultAzureCredential only.
# Sign in locally with `az login` (or rely on a managed identity when hosted).
# No keys or service-principal secrets are required or read by the app.
